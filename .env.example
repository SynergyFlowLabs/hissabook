# Required for production Auth.js sessions. Generate a unique secret, e.g. `npx auth secret`.
AUTH_SECRET=replace-with-a-long-random-secret

# Optional path for the local SQLite database (default: ./data/hisaabook.sqlite)
# DATABASE_PATH=./data/hisaabook.sqlite

# Production only: Supabase PostgreSQL transaction-pooler URL. Keep private; never use a NEXT_PUBLIC_ prefix.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
